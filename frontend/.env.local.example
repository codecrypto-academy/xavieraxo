# Direccion del contrato SupplyChainTracker desplegado.
# Preferido: generar este archivo con el script de sync tras el deploy:
#   node scripts/sync-contract-address.mjs
#   o: powershell -ExecutionPolicy Bypass -File scripts/deploy-local.ps1
#   o Sepolia: powershell -ExecutionPolicy Bypass -File scripts/deploy-sepolia.ps1
#
# Fallback manual: copia este archivo como `.env.local` y pega la address.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Red esperada por la DApp:
# 31337 = Anvil local | 11155111 = Sepolia
NEXT_PUBLIC_CHAIN_ID=31337

# Opcional (recomendado en Sepolia): RPC usado al agregar la red en MetaMask
# NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org

# Solo para capturas locales (OFF por defecto en entrega/evaluación):
# NEXT_PUBLIC_DEMO_UI=1
